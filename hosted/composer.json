{
    "name": "factstudio/control-room",
    "type": "project",
    "description": "FACT Studio hosted dashboard and office worker bridge",
    "license": "proprietary",
    "require": {"php": "^8.3", "laravel/framework": "^13.17"},
    "autoload": {"psr-4": {"App\\": "app/"}},
    "config": {"platform": {"php": "8.3.36"}, "optimize-autoloader": true, "sort-packages": true},
    "scripts": {"post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"]},
    "minimum-stability": "stable",
    "prefer-stable": true
}
